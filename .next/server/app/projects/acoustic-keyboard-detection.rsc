der-zinc-200 p-8 dark:border-zinc-800","children":[["$","h3",null,{"className":"text-xl font-semibold text-zinc-900 dark:text-white","children":"Architecture snapshot"}],["$","p",null,{"className":"mt-4 text-sm text-zinc-600 dark:text-zinc-300","children":"The app wraps signal processing, model scoring, and UX in a single Streamlit deployment. Librosa handles feature extraction while TensorFlow serves a frozen SavedModel. A lightweight inference cache prevents double-processing repeated clips, and the UI streams probability curves to keep users engaged."}],["$","ul",null,{"className":"mt-6 grid gap-3 text-sm text-zinc-600 dark:text-zinc-300","children":[["$","li","Python",{"className":"rounded-2xl border border-zinc-100 px-4 py-3 dark:border-zinc-800","children":"Python"}],["$","li","Librosa",{"className":"rounded-2xl border border-zinc-100 px-4 py-3 dark:border-zinc-800","children":"Librosa"}],["$","li","NumPy",{"className":"rounded-2xl border border-zinc-100 px-4 py-3 dark:border-zinc-800","children":"NumPy"}],["$","li","TensorFlow / Keras",{"className":"rounded-2xl border border-zinc-100 px-4 py-3 dark:border-zinc-800","children":"TensorFlow / Keras"}],["$","li","Scikit-learn",{"className":"rounded-2xl border border-zinc-100 px-4 py-3 dark:border-zinc-800","children":"Scikit-learn"}],["$","li","Streamlit",{"className":"rounded-2xl border border-zinc-100 px-4 py-3 dark:border-zinc-800","children":"Streamlit"}]]}]]}],["$","div",null,{"className":"rounded-3xl border border-zinc-200 p-8 dark:border-zinc-800","children":[["$","h3",null,{"className":"text-xl font-semibold text-zinc-900 dark:text-white","children":"Interactive UX"}],["$","p",null,{"className":"mt-4 text-sm text-zinc-600 dark:text-zinc-300","children":"Users can upload WAV/MP3 files or record directly via the browser. The app visualizes spectrograms, MFCC heatmaps, and rolling predictions so researchers can see why the classifier triggers. A guided checklist nudges users to test multiple keyboards, distances, and ambient noise levels."}],["$","div",null,{"className":"mt-6 rounded-2xl bg-zinc-900/5 p-5 text-sm text-zinc-700 dark:bg-white/5 dark:text-zinc-200","children":[["$","p",null,{"children":[["$","span",null,{"className":"font-semibold","children":"Inference latency:"}]," < 600 ms per 3s clip"]}],["$","p",null,{"children":[["$","span",null,{"className":"font-semibold","children":"Accuracy window:"}]," optimized for 1–5 ft microphone range"]}],["$","p",null,{"children":[["$","span",null,{"className":"font-semibold","children":"Accessibility toggle:"}]," optional haptic/audio cues for low-vision testers"]}]]}]]}]]}],["$","section",null,{"className":"space-y-8","children":[["$","div",null,{"className":"max-w-2xl","children":[["$","h3",null,{"className":"text-2xl font-semibold text-zinc-900 dark:text-white","children":"Workflow and guardrails"}],["$","p",null,{"className":"mt-3 text-base text-zinc-600 dark:text-zinc-300","children":"Each run pushes audio through the same reproducible pipeline used in model development. This keeps live traffic aligned with the training distribution and makes it easy to retrain when we collect new acoustic signatures."}]]}],["$","div",null,{"className":"grid gap-6 lg:grid-cols-4","children":[["$","div","Audio ingestion",{"className":"rounded-3xl border border-zinc-200 p-6 dark:border-zinc-800","children":[["$","h4",null,{"className":"text-base font-semibold text-zinc-900 dark:text-white","children":"Audio ingestion"}],["$","p",null,{"className":"mt-3 text-sm text-zinc-600 dark:text-zinc-300","children":"Streamlit records or accepts WAV uploads, normalizes bit-depth, and trims silence so the classifier only sees meaningful signal."}]]}],["$","div","MFCC feature grid",{"className":"rounded-3xl border border-zinc-200 p-6 dark:border-zinc-800","children":[["$","h4",null,{"className":"text-base font-semibold text-zinc-900 dark:text-white","children":"MFCC feature grid"}],["$","p",null,{"className":"mt-3 text-sm text-zinc-600 dark:text-zi
ildren":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-brand-500"}],["$","p",null,{"children":[["$","span",null,{"className":"font-semibold text-zinc-900 dark:text-white","children":"590 sensors x 178 wafers/lot:"}]," raw telemetry streamed from Advantest V93000 handlers into S3 via Kinesis Firehose every 7 minutes."]}]]}],["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-brand-500"}],["$","p",null,{"children":[["$","span",null,{"className":"font-semibold text-zinc-900 dark:text-white","children":"92% precision floor:"}]," business threshold to avoid swamping operators with false alarms."]}]]}],["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-brand-500"}],["$","p",null,{"children":[["$","span",null,{"className":"font-semibold text-zinc-900 dark:text-white","children":"p99 latency < 2.5s:"}]," required for real-time gating before wafers hit burn-in."]}]]}]]}]}]]}],["$","section",null,{"className":"grid gap-6 lg:grid-cols-2","children":[["$","div",null,{"className":"rounded-3xl border border-zinc-200 p-8 dark:border-zinc-800","children":[["$","h3",null,{"className":"text-xl font-semibold text-zinc-900 dark:text-white","children":"Architecture snapshot"}],["$","p",null,{"className":"mt-4 text-sm text-zinc-600 dark:text-zinc-300","children":"Streaming telemetry lands in S3, kicks off Step Functions that run validation, clustering, model selection, and metric logging. Inference lives inside a FastAPI service containerized via Docker, deployed on Elastic Beanstalk with autoscaling rules tied to lot volume."}],["$","ul",null,{"className":"mt-6 grid gap-3 text-sm text-zinc-600 dark:text-zinc-300","children":[["$","li","FastAPI scoring service",{"className":"rounded-2xl border border-zinc-100 px-4 py-3 dark:border-zinc-800","children":"FastAPI scoring service"}],["$","li","Docker + GitHub Actions",{"className":"rounded-2xl border border-zinc-100 px-4 py-3 dark:border-zinc-800","children":"Docker + GitHub Actions"}],["$","li","AWS S3, SQS, Step Functions",{"className":"rounded-2xl border border-zinc-100 px-4 py-3 dark:border-zinc-800","children":"AWS S3, SQS, Step Functions"}],["$","li","Elastic Beanstalk (Blue/Green)",{"className":"rounded-2xl border border-zinc-100 px-4 py-3 dark:border-zinc-800","children":"Elastic Beanstalk (Blue/Green)"}],["$","li","Grafana + Prometheus",{"className":"rounded-2xl border border-zinc-100 px-4 py-3 dark:border-zinc-800","children":"Grafana + Prometheus"}]]}]]}],["$","div",null,{"className":"rounded-3xl border border-zinc-200 p-8 dark:border-zinc-800","children":[["$","h3",null,{"className":"text-xl font-semibold text-zinc-900 dark:text-white","children":"Ops automation"}],["$","p",null,{"className":"mt-4 text-sm text-zinc-600 dark:text-zinc-300","children":"GitHub Actions handles build-test-lint, launches smoke tests against the Beanstalk staging env, and rolls traffic with a blue/green swap. Model metadata and experiment lineage live in MLflow so the quality team can audit every promotion."}],["$","div",null,{"className":"mt-6 rounded-2xl bg-zinc-900/5 p-5 text-sm text-zinc-700 dark:bg-white/5 dark:text-zinc-200","children":[["$","p",null,{"children":[["$","span",null,{"className":"font-semibold","children":"CI runtime:"}]," 6m 20s"]}],["$","p",null,{"children":[["$","span",null,{"className":"font-semibold","children":"Promotion cadence:"}]," weekly or on drift alert"]}],["$","p",null,{"children":[["$","span",null,{"className":"font-semibold","children":"Rollback budget:"}]," < 30s via blue/green swap"]}]]}]]}]]}],["$","section",null,{"className":"space-y-8","children":[["$","div",null,{"className":"max-w-2xl","children":[["$","h3",null,{"className":"text-2xl font-semibold text-zinc-900 dark:text-white","children":"Pipeline, modeling, and guardrails"}],["$","p",null,{"className":"mt-3 text-base text-zinc-600 dark:text-zinc-300","children":"Each wafer is processed as a multivariate sequence. LightGBM was considered but ultimately rejected because tree-based methods with class weighting hit the latency budget without GPU burn. Guardrails keep the system safe even when a fab recalibrates sensors mid-shift."}]]}],["$","div",null,{"className":"grid gap-6 lg:grid-cols-3","children":[["$","div","Sensor integrity gate",{"className":"rounded-3xl border border-zinc-200 p-6 dark:border-zinc-800","children":[["$","h4",null,{"className":"text-base font-semibold text-zinc-900 dark:text-white","children":"Sensor integrity gate"}],["$","p",null,{"className":"mt-3 text-sm text-zinc-600 dark:text-zinc-300","children":"Validates 590-sensor payloads in less than 800 ms with schema checks, missing value heuristics, and 3-sigma drift rules before persisting to S3."}]]}],["$","div","Feature alignment",{"className":"rounded-3xl border border-zinc-200 p-6 dark:border-zinc-800","children":[["$","h4",null,{"className":"text-base font-semibold text-zinc-900 dark:text-white","children":"Feature alignment"}],["$","p",null,{"className":"mt-3 text-sm text-zinc-600 dark:text-zinc-300","children":"Interpolates out-of-phase signals and standardizes per-sensor distributions to keep the downstream clustering step stable across fabs."}]]}],["$","div","Adaptive clustering",{"className":"rounded-3xl border border-zinc-200 p-6 dark:border-zinc-800","children":[["$","h4",null,{"className":"text-base font-semibold text-zinc-900 dark:text-white","children":"Adaptive clustering"}],["$","p",null,{"className":"mt-3 text-sm text-zinc-600 dark:text-zinc-300","children":"Uses a silhouette-tuned DBSCAN job (or K-Means fallback) to group wafers with similar fault signatures, enabling per-cluster model selection."}]]}],["$","div","Model selector",{"className":"rounded-3xl border border-zinc-200 p-6 dark:border-zinc-800","children":[["$","h4",null,{"className":"text-base font-semibold text-zinc-900 dark:text-white","children":"Model selector"}],["$","p",null,{"className":"mt-3 text-sm text-zinc-600 dark:text-zinc-300","children":"Tests Random Forest vs. XGBoost per cluster each week; promotes the champion to the inference stack with shadow validation in SageMaker notebooks."}]]}]]}],["$","div",null,{"className":"grid gap-6 lg:grid-cols-3","children":[["$","div","Lot-level backtesting",{"className":"rounded-3xl border border-zinc-200 p-6 dark:border-zinc-800","children":[["$","h4",null,{"className":"text-base font-semibold text-zinc-900 dark:text-white","children":"Lot-level backtesting"}],["$","p",null,{"className":"mt-3 text-sm text-zinc-600 dark:text-zinc-300","children":"Replays the last 90 days of production lots nightly with time-based splits to ensure no leakage in metric reporting."}]]}],["$","div","Fail-fast canaries",{"className":"rounded-3xl border border-zinc-200 p-6 dark:border-zinc-800","children":[["$","h4",null,{"className":"text-base font-semibold text-zinc-900 dark:text-white","children":"Fail-fast canaries"}],["$","p",null,{"className":"mt-3 text-sm text-zinc-600 dark:text-zinc-300","children":"Routes 2% of wafers through a shadow stack whenever a new model is promoted; aborts automatically if precision drops below 92%."}]]}],["$","div","Sensor drift monitors",{"className":"rounded-3xl border border-zinc-200 p-6 dark:border-zinc-800","children":[["$","h4",null,{"className":"text-base font-semibold text-zinc-900 dark:text-white","children":"Sensor drift monitors"}],["$","p",null,{"className":"mt-3 text-sm text-zinc-600 dark:text-zinc-300","children":"Publishes a drift score per sensor to Grafana; alerts trigger when the KL divergence vs. baseline exceeds 0.08 for 15 mins."}]]}]]}]]}],["$","section",null,{"className":"rounded-3xl border border-zinc-200 p-8 dark:border-zinc-800","children":["$","div",null,{"className":"grid gap-10 lg:grid-cols-2","children":[["$","div",null,{"children":[["$","h3",null,{"className":"text-xl font-semibold text-zinc-900 dark:text-white","children":"Outcomes"}],["$","u